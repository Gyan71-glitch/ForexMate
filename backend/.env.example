# Backend Environment Variables
# Copy this file to .env and fill in your values.

# Neon / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# FastForex API Key (from fastforex.io)
FASTFOREX_API_KEY=your-fastforex-key-here

# JWT Secret (pick a long random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Comma-separated list of allowed frontend origins for CORS
# In development: http://localhost:3000
# In production: https://your-app.vercel.app,https://www.forexmate.com
CORS_ORIGINS=http://localhost:3000

# Port the backend listens on (default 3001)
PORT=3001
